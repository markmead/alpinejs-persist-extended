{
  "name": "alpinejs-persist-extended",
  "version": "2.0.0",
  "description": "Extends the official Alpine JS `$persist` plugin with expiring values and imperative read, write, delete and clear helpers 📦",
  "keywords": [
    "alpine",
    "alpinejs",
    "alpinejs-plugin",
    "persist",
    "storage",
    "localstorage",
    "expiry",
    "ttl"
  ],
  "license": "MIT",
  "author": "Mark Mead",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markmead/alpinejs-persist-extended.git"
  },
  "homepage": "https://github.com/markmead/alpinejs-persist-extended#readme",
  "bugs": "https://github.com/markmead/alpinejs-persist-extended/issues",
  "main": "dist/module.cjs",
  "module": "dist/module.mjs",
  "unpkg": "dist/cdn.min.js",
  "exports": {
    ".": {
      "import": "./dist/module.mjs",
      "require": "./dist/module.cjs",
      "default": "./dist/module.mjs"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "packageManager": "pnpm@11.1.3"
}
